generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  youtube
  tiktok
  twitch
  kick
}

enum StreamSessionStatus {
  idle
  live
  ended
}

enum StreamEventType {
  chat
  donation
  follow
  subscribe
  member
  raid
  system
}

enum PlatformConnectionStatus {
  connected
  disconnected
  error
}

model User {
  id                  String               @id
  email               String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            StreamSession[]
  events              StreamEvent[]
  platformConnections PlatformConnection[]
}

model PlatformConnection {
  id                   String                   @id @default(cuid())
  userId               String
  platform             Platform
  platformUserId       String
  platformUsername     String?
  accessTokenEncrypted String                   @db.Text
  refreshTokenEncrypted String?                 @db.Text
  tokenExpiresAt       DateTime?
  scopes               String[]                 @default([])
  status               PlatformConnectionStatus @default(connected)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, platformUserId])
  @@index([userId])
  @@index([userId, platform])
}

model StreamSession {
  id        String             @id
  userId    String
  status    StreamSessionStatus
  platforms Platform[]
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events StreamEvent[]

  @@index([userId])
}

model StreamEvent {
  id        String           @id
  userId    String
  sessionId String?
  platform  Platform
  type      StreamEventType
  username  String
  message   String?
  amount    Float?
  currency  String?
  timestamp DateTime
  createdAt DateTime         @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session StreamSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}
